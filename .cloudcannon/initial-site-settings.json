{
  "ssg": "eleventy",
  "mode": "hosted",
  "build": {
    "hugoVersion": "0.128.1",
    "rubyVersion": "2.7.3",
    "nodeVersion": "24",
    "denoVersion": "1.40.2",
    "output": "public",
    "preserved_paths": "node_modules/, img/, fonts/,.cache",
    "config": "",
    "formats": "",
    "input": "",
    "pathprefix": "",
    "quiet": false,
    "incremental": true,
    "ignoreinitial": false,
    "preserveOutput": true,
    "includeGit": false,
    "manage_plugin_manually": false,
    "use_beta_plugin": false,
    "environment_variables": [
      {
        "key": "ELEVENTY_ENV",
        "value": "production"
      }
    ],
    "output_path": "public",
    "build_command": "npm run build",
    "install_command": "npm i"
  }
}