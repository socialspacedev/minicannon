{% comment %}
 Automated Title
{% endcomment %}
{% if seoTitle -%}{% assign pageTitle = seoTitle -%}{% else -%}{% assign pageTitle = title | default: '' -%}{% assign pageTitle = pageTitle | append: ' - ' | append: meta.siteName -%}{% endif -%}

{% comment %}
  Automated Description
{% endcomment %}
{% assign pageDescription = description | default: '' -%}{% assign pageDescription = pageDescription | default: '' -%}

{% comment %}
  Page URL
{% endcomment %}

{% comment %}
  Start Head
{% endcomment %}
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {% comment %}
    About Page
  {% endcomment %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}" />
  <meta name="keywords" content="{{ pageKeyword }}" />
  <meta name="creation_Date" content="{{ meta.creationDate }}" />

    {% comment %}
      Robot
    {% endcomment %}
  <meta name="robots" content="{{ meta.robots }}" />

    {% comment %}
      Author
    {% endcomment %}
  <meta name="author" content="{{ meta.authorName }}" />

    {% comment %}
      Fonts
    {% endcomment %}
  <style>
{%- comment %}
  One variable file for every weight (300–800), so the medium/bold weights
  arrive with the regular one instead of missing the `optional` window.
  Built from Google's Roboto Serif variable font: opsz pinned at 14 (matches
  the old static files' metrics), wdth 100, GRAD 0, latin + latin-ext only.
{% endcomment %}
@font-face {
  font-display: optional;
  font-family: 'Roboto Serif';
  font-style: normal;
  font-weight: 300 800;
  font-stretch: 100%;
  src: url('/fonts/roboto-serif-variable.woff2') format('woff2');
}
  </style>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/roboto-serif-variable.woff2" crossorigin="anonymous" fetchpriority="high">
  
  {% comment %}
    CSS
  {% endcomment %}
  <link
    rel="preload"
    href="{{  '/css/style.css' | url }}"
    as="style"
    fetchpriority="high"
    />
  <link
    rel="stylesheet"
    href="{{  '/css/style.css' | url }}"
    media="all" />

    {% comment %}
      Sitemap
    {% endcomment %}
  <link rel="canonical" href="{{ meta.url }}{{ page.url }}" />
  <link
    rel="sitemap"
    type="application/xml"
    title="Sitemap for {{ meta.siteName }}"
    href="{{ '/sitemap.xml' | url }}" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title="RSS Feed for {{ meta.siteName }}"
    href="{{ '/feed.xml' | url }}" />

    {% comment %}
      Favicon
    {% endcomment %}
  <link
    rel="shortcut icon"
    href="{{ '/favicon/favicon.ico' | url }}"
    sizes="any" />

  {% comment %}
    Social share image — fallback chain: thumbnail → hero image → site default
  {% endcomment %}
  {%- assign ogImage = thumbnail -%}
  {%- if ogImage == blank and certain_sound.hero_image -%}{%- assign ogImage = certain_sound.hero_image -%}{%- endif -%}
  {%- if ogImage == blank -%}{%- assign ogImage = meta.defaultImage -%}{%- endif -%}

  {% comment %}
    Open Graph
  {% endcomment %}
  <meta property="og:type" content="{{ type }}" />
  <meta property="og:locale" content="{{ meta.language }}" />
  <meta property="og:site_name" content="{{ meta.siteName }}" />
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:description" content="{{ pageDescription }}" />
  <meta property="og:url" content="{{ meta.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ meta.url }}{{ ogImage }}" />
  <meta property="og:image:alt" content="{{ pageTitle }}" />

  {% comment %}
    Twitter / X Card
  {% endcomment %}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ pageTitle }}" />
  <meta name="twitter:description" content="{{ pageDescription }}" />
  <meta name="twitter:image" content="{{ meta.url }}{{ ogImage }}" />

    {% comment %}
      Facebook
    {% endcomment %}
  <meta property="fb:admins" content="{{ meta.facebookUsername }}" />
  
    {% comment %}
      100% privacy-first analytics
    {% endcomment %}
<script data-collect-dnt="true" async defer src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
</head>