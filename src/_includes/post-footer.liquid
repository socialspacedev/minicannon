{%- comment -%}
  One footer for every post: show links (Certain Sound / Vinyl Vibes) on the
  left, the Share button on the right, all as matching pill buttons. Labels stay
  short; the full wording is in title/aria-label.
{%- endcomment -%}
<footer class="post-footer">
  {%- if certain_sound or vinyl_vibes -%}
  <ul class="post-footer__links">
    {%- if certain_sound -%}
    {%- if certain_sound.oar_url -%}
    <li><a class="pill" href="{{ certain_sound.oar_url }}" target="_blank" rel="noopener noreferrer" title="Listen to this episode on Otago Access Radio" aria-label="Listen to this episode on Otago Access Radio">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16l13 -8z" /></svg>
      <span>Listen</span>
    </a></li>
    {%- endif -%}
    <li><a class="pill" href="https://oar.org.nz/shows/certain-sound/" target="_blank" rel="noopener noreferrer" title="Certain Sound on Otago Access Radio" aria-label="Certain Sound on Otago Access Radio">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3l-9.371 3.749a1 1 0 0 0 -.629 .928v11.323a1 1 0 0 0 1 1h14a1 1 0 0 0 1 -1v-11a1 1 0 0 0 -1 -1h-14.5" /><path d="M4 12h16" /><path d="M7 12v-2" /><path d="M17 16v.01" /><path d="M13 16v.01" /></svg>
      <span>The show</span>
    </a></li>
    {%- endif -%}
    {%- if vinyl_vibes -%}
    <li><a class="pill" href="https://www.facebook.com/share/g/1BMZqvXHzP/" target="_blank" rel="noopener noreferrer" title="Vinyl Vibes on Facebook" aria-label="Vinyl Vibes on Facebook">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" /></svg>
      <span>Facebook</span>
    </a></li>
    {%- endif -%}
  </ul>
  {%- endif -%}
  {% include "share-trigger.liquid" %}
</footer>
